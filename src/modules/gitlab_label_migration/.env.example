# GitLab Label Migration Configuration
# Copy this file to .env and fill in your actual values

# GitLab Personal Access Token
# Required scopes: api, read_api
# Generate at: https://gitlab.com/-/user_settings/personal_access_tokens
GITLAB_TOKEN=your_personal_access_token_here

# Source Project ID (where labels will be copied from)
# Find this in your GitLab project settings or URL
SOURCE_PROJECT_ID=12345

# Destination Project ID (where labels will be copied to)
# Find this in your GitLab project settings or URL
DESTINATION_PROJECT_ID=67890

# GitLab Instance URL (optional, defaults to https://gitlab.com)
# For self-hosted GitLab instances, change this to your instance URL
# GITLAB_URL=https://gitlab.com
